# ─── Server & Database ────────────────────────────────────────────────────────
PORT=3001
DATA_DIR=./server/data
DB_PATH=./server/data/portfolio.db

# ─── Authentication & Security ────────────────────────────────────────────────
JWT_SECRET=portfolio-dev-secret-change-in-prod
DEFAULT_PASSWORD=132456
JWT_EXPIRY_HOURS=720

# ─── Binance API & Network ───────────────────────────────────────────────────
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FAPI_URL=https://fapi.binance.com
BINANCE_DAPI_URL=https://dapi.binance.com
BINANCE_RECV_WINDOW_MS=5000
BINANCE_TIME_SYNC_INTERVAL_MS=300000
SIMPLE_EARN_PAGE_SIZE=100
BINANCE_HTTP_TIMEOUT_SEC=15
# Optional credentials. Keep these empty in the example file.
BINANCE_API_KEY=
BINANCE_API_SECRET=
VITE_BINANCE_API_KEY=
VITE_BINANCE_API_SECRET=

# ─── FX Currency Rates ────────────────────────────────────────────────────────
FX_RATE_ENDPOINTS=https://open.er-api.com/v6/latest/USD,https://api.exchangerate-api.com/v4/latest/USD
FX_HTTP_TIMEOUT_SEC=8

# ─── Portfolio Business Rules & Thresholds ────────────────────────────────────
DUST_THRESHOLD_USDT=0.50
ACTION_THRESHOLD_PCT=0.50

# ─── Rebalance & Trading Engine ───────────────────────────────────────────────
REBALANCE_MIN_TRADE_USDT=5.0
REBALANCE_THRESHOLD_PCT=1.0
REBALANCE_FEE_RATE=0.001

# ─── Settings & Asset Whitelist ───────────────────────────────────────────────
ALLOWED_SETTING_KEYS=credentials,targets,archived,currency
POPULAR_COINS=BTC,ETH,SOL,BNB,DOGE,XRP,ADA,AVAX,DOT,LINK,MATIC,LTC,ATOM,UNI,NEAR,APT,ARB,OP,FDUSD,USDT,USDC,FUTURES_USDT,OTHER

# ─── Narrative Free Providers ────────────────────────────────────────────────
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
NARRATIVE_COINGECKO_MARKET_IDS=bitcoin,ethereum,solana,binancecoin,avalanche-2,sui,aptos,near,fetch-ai,render-token,the-graph,ocean-protocol,singularitynet,ondo-finance,chainlink,maker,pax-gold,filecoin,arweave,helium,theta-token,stacks,ordinals,arbitrum,optimism,polygon-ecosystem
ALTERNATIVE_ME_FEAR_GREED_URL=https://api.alternative.me/fng/?limit=1&format=json
NARRATIVE_BINANCE_BASE_URL=https://api.binance.com
REDDIT_RSS_URL=https://www.reddit.com/r/CryptoCurrency/.rss
NARRATIVE_RSS_FEEDS=https://www.reddit.com/r/CryptoCurrency/.rss,https://www.coindesk.com/arc/outboundfeeds/rss/,https://decrypt.co/feed
ETHEREUM_RPC_URL=https://cloudflare-eth.com
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BITCOIN_API_URL=https://mempool.space/api/v1/blocks
NARRATIVE_ASSET_ALIASES=RNDR=RENDER,MATIC=POL
NARRATIVE_ALIASES=ai-agents=AI agents|agentic|Fetch.ai|Artificial Superintelligence|NEAR|Render|RNDR|GRT|OCEAN|AGIX;rwa=real world asset|tokenization|Ondo|ONDO|Chainlink|MKR|PAXG;depin=DePIN|decentralized physical|Render|Filecoin|Arweave|Helium|Theta;btc-fi=Bitcoin|BTC|Ordinals|Stacks|STX;l1-chains=Solana|SOL|BNB Chain|Avalanche|Sui|Aptos|NEAR;eth-l2s=Ethereum|Arbitrum|Optimism|Polygon|rollup|Layer 2|L2
NARRATIVE_ONCHAIN_CHAINS=eth-l2s=evm-l2,rwa=ethereum,l1-chains=solana,btc-fi=bitcoin
NARRATIVE_HTTP_TIMEOUT_SEC=12
NARRATIVE_CACHE_MINUTES=5
NARRATIVE_REFRESH_MINUTES=15
NARRATIVE_HISTORY_RETENTION_DAYS=30

# ─── Narrative Scoring ────────────────────────────────────────────────────────
NARRATIVE_MARKET_WEIGHT=0.25
NARRATIVE_VOLUME_WEIGHT=0.25
NARRATIVE_SOCIAL_WEIGHT=0.20
NARRATIVE_ONCHAIN_WEIGHT=0.20
NARRATIVE_CATALYST_WEIGHT=0.10
NARRATIVE_CROWDED_THRESHOLD=75
NARRATIVE_GROWING_THRESHOLD=55
NARRATIVE_DIRECTION_THRESHOLD=5
NARRATIVE_SCORE_BASE=50
NARRATIVE_SCORE_SCALE=2

# ─── Premium/Free-Tier Narrative Providers ──────────────────────────────────
LUNARCRUSH_ENABLED=true
LUNARCRUSH_API_KEY=
LUNARCRUSH_BASE_URL=https://lunarcrush.com/api4
LUNARCRUSH_ENDPOINT_TEMPLATE=/public/coins/{symbol}/v1
LUNARCRUSH_AUTH_HEADER=Authorization
LUNARCRUSH_SOCIAL_SCORE_PATH=data.0.galaxy_score
LUNARCRUSH_MENTIONS_PATH=data.0.posts_active
LUNARCRUSH_ENGAGEMENT_PATH=data.0.interactions
LUNARCRUSH_MENTIONS_BASELINE=25
LUNARCRUSH_ENGAGEMENT_BASELINE=1000

COINGLASS_ENABLED=true
COINGLASS_API_KEY=
COINGLASS_BASE_URL=https://open-api-v4.coinglass.com
COINGLASS_ENDPOINT_TEMPLATE=/api/futures/open-interest/exchange-list?symbol={symbol}
COINGLASS_AUTH_HEADER=CG-API-KEY
COINGLASS_OPEN_INTEREST_PATH=data.0.openInterest
COINGLASS_FUNDING_RATE_PATH=
COINGLASS_LIQUIDATIONS_PATH=
COINGLASS_OPEN_INTEREST_BASELINE=10000000
COINGLASS_FUNDING_RATE_BASELINE=0.0001
COINGLASS_LIQUIDATIONS_BASELINE=1000000

CRYPTOQUANT_ENABLED=true
CRYPTOQUANT_API_KEY=
CRYPTOQUANT_BASE_URL=https://api.cryptoquant.com/v1
CRYPTOQUANT_ENDPOINT_TEMPLATE=/btc/network-indicator/active-addresses?window=day&limit=1
CRYPTOQUANT_EXCHANGE_FLOW_ENDPOINT_TEMPLATE=/btc/exchange-flows/netflow?exchange=all_exchange&window=day&limit=1
CRYPTOQUANT_RESERVE_ENDPOINT_TEMPLATE=/btc/exchange-flows/reserve?exchange=all_exchange&window=day&limit=1
CRYPTOQUANT_AUTH_HEADER=Authorization
CRYPTOQUANT_ACTIVE_ADDRESS_PATH=result.data.0.active_addresses
CRYPTOQUANT_EXCHANGE_FLOW_PATH=result.data.0.netflow_total
CRYPTOQUANT_RESERVE_PATH=result.data.0.reserve
CRYPTOQUANT_ACTIVE_ADDRESS_BASELINE=500000
CRYPTOQUANT_EXCHANGE_FLOW_BASELINE=1000
CRYPTOQUANT_RESERVE_BASELINE=500000
